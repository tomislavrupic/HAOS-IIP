{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tomislavrupic/HAOS-IIP/docs/claim_governance/claim_contract.schema.json",
  "title": "HAOS-IIP public claim contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "claim_id", "claim_title", "claim_class",
    "overall_status", "bridge_status", "claim_text", "evidence_scope",
    "selection_history", "perturbation_domain", "telemetry",
    "controls", "reproduction", "claim_boundary"
  ],
  "properties": {
    "contract_version": {"const": "1.0"},
    "claim_id": {"type": "string", "minLength": 1},
    "claim_title": {"type": "string", "minLength": 1},
    "claim_class": {"enum": ["A", "B", "C", "D", "E", "F", "G", "H"]},
    "overall_status": {"enum": ["PASS", "OPEN", "FAIL"]},
    "bridge_status": {
      "enum": [
        "INTERNAL_DIAGNOSTIC_ONLY", "NUMERICALLY_SUGGESTIVE",
        "ANALOGY_ONLY", "BRIDGE_HYPOTHESIS", "EXTERNALLY_TESTABLE_CANDIDATE",
        "EXTERNALLY_SUPPORTED", "FAILED_UNDER_CURRENT_TESTS"
      ]
    },
    "claim_text": {"type": "string", "minLength": 1},
    "evidence_scope": {
      "enum": ["INTERNAL_NUMERICAL", "STRUCTURAL", "SCALING", "EXTERNAL_PROXY", "PHYSICAL_CORRESPONDENCE"]
    },
    "selection_history": {
      "type": "object", "additionalProperties": false,
      "required": ["disclosure_status", "selection_rule", "alternatives_considered", "unreported_exploration_known_absent"],
      "properties": {
        "disclosure_status": {"enum": ["COMPLETE", "PARTIAL", "UNKNOWN"]},
        "selection_rule": {"type": "string", "minLength": 1},
        "alternatives_considered": {"type": "array", "items": {"type": "string"}},
        "unreported_exploration_known_absent": {"type": "boolean"},
        "limitations": {"type": "string"}
      }
    },
    "perturbation_domain": {
      "type": "object", "additionalProperties": false,
      "required": ["included", "omitted", "applicability_statement"],
      "properties": {
        "included": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "omitted": {"type": "array", "items": {"type": "string"}},
        "applicability_statement": {"type": "string", "minLength": 1}
      }
    },
    "telemetry": {
      "type": "object", "additionalProperties": false,
      "required": ["primary", "alternatives_tested", "sensitivity_status"],
      "properties": {
        "primary": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "alternatives_tested": {"type": "array", "items": {"type": "string"}},
        "sensitivity_status": {"enum": ["PASS", "OPEN", "FAIL"]},
        "limitations": {"type": "string"}
      }
    },
    "controls": {
      "type": "object", "additionalProperties": false,
      "required": ["tested", "omitted_adversarial_controls", "specificity_status"],
      "properties": {
        "tested": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "matched_properties", "result", "status"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "matched_properties": {"type": "array", "items": {"type": "string"}},
              "result": {"type": "string", "minLength": 1},
              "status": {"enum": ["PASS", "OPEN", "FAIL"]}
            }
          }
        },
        "omitted_adversarial_controls": {"type": "array", "items": {"type": "string"}},
        "specificity_status": {"enum": ["PASS", "OPEN", "FAIL"]}
      }
    },
    "reproduction": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_status", "execution_status", "independent_replication_status", "commands", "artifacts"],
      "properties": {
        "artifact_status": {"enum": ["ARTIFACT_VERIFIED", "NOT_DEMONSTRATED"]},
        "execution_status": {"enum": ["EXECUTION_REPRODUCED", "NOT_DEMONSTRATED"]},
        "independent_replication_status": {"enum": ["INDEPENDENTLY_REPLICATED", "NOT_DEMONSTRATED"]},
        "commands": {"type": "array", "items": {"type": "string"}},
        "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "limitations": {"type": "string"}
      }
    },
    "claim_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed_language", "not_claimed", "downgrade_condition", "kill_condition", "physical_correspondence_status"],
      "properties": {
        "allowed_language": {"type": "string", "minLength": 1},
        "not_claimed": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "downgrade_condition": {"type": "string", "minLength": 1},
        "kill_condition": {"type": "string", "minLength": 1},
        "physical_correspondence_status": {"enum": ["SUPPORTED", "NOT_DEMONSTRATED", "FAILED"]}
      }
    }
  }
}

